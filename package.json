{
	"name": "@anweb/nuxt-ancore",
	"version": "1.21.0",
	"description": "Ancore Nuxt module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ANLTD/ancore.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/module.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/module.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "nuxt-module-build build",
		"dev": "npm run dev:prepare && nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"release": "release-it",
		"update": "npx -y npm-check-updates -u"
	},
	"dependencies": {
		"@vueuse/core": "^15.0.0",
		"@vueuse/integrations": "^15.0.0",
		"async-validator": "^4.2.5",
		"c12": "^3.3.4",
		"i18next": "^27.1.1"
	},
	"devDependencies": {
		"@nuxt/devtools": "^4.1.0",
		"@nuxt/kit": "^4.6.4",
		"@nuxt/module-builder": "^1.0.4",
		"@nuxt/schema": "^4.6.4",
		"@types/node": "latest",
		"changelogen": "^0.6.2",
		"nuxt": "^4.6.4",
		"release-it": "^21.1.2",
		"typescript": "~5.9.3",
		"vue-tsc": "^3.3.14"
	},
	"overrides": {
		"mkdist": {
			"esbuild": "^0.28.0"
		}
	}
}
